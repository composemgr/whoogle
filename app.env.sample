# app.env.sample
# Copy to app.env and adjust values before starting the stack.
# These variables override the matching values in default.env for this app.
# No `export` prefix - this file is read by `docker compose --env-file`.

TZ=America/New_York
BASE_DOMAIN_NAME=example.com
BASE_HOST_NAME=whoogle.example.com

APP_ORG_NAME=Whoogle

# Encryption key for saved search preferences (min 32 characters)
APP_SECRET_KEY=replace-with-a-random-32-byte-hex-string

# Search region and language
WHOOGLE_CONFIG_COUNTRY=US
WHOOGLE_CONFIG_LANGUAGE=lang_en
WHOOGLE_CONFIG_SEARCH_LANGUAGE=lang_en
WHOOGLE_CONFIG_THEME=dark
WHOOGLE_CONFIG_RESULTS_PER_PAGE=50

# Optional upstream proxy (leave blank to disable)
WHOOGLE_PROXY_TYPE=
WHOOGLE_PROXY_LOC=
