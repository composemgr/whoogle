# Whoogle Search - app.env.sample
# Copy to app.env and adjust values before starting

# Hostname / domain
BASE_HOST_NAME=$HOSTNAME
BASE_DOMAIN_NAME=example.com

# Preferences encryption key (min 32 chars)
APP_API_TOKEN=changeme_secret_key_min_32_chars

# Optional proxy settings (leave blank to disable)
WHOOGLE_PROXY_TYPE=
WHOOGLE_PROXY_LOC=
